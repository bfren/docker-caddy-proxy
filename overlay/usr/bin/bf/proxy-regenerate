#!/usr/bin/nu

use bf
use bf-proxy
bf env load -x

# Regenerate Caddy configuration from conf.json and reload Caddy
def main [
    --domain (-d): string   # Only regenerate the configuration file for this domain
    --force (-f)            # Regenerate domain configuration files even if they are marked as custom
] {
    bf-proxy generate --domain=$domain --force=$force
    bf ch apply_file "20-proxy"
    bf-proxy reload
}
